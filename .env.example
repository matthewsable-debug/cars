# Copy to .env and fill in. Everything here is optional: with no SMTP_HOST the
# app runs fully, emailing in "dry-run" mode (writes to <DATA_DIR>/outbox).

# Where to send the daily digest (comma-separated addresses allowed).
MAIL_TO=you@example.com
MAIL_FROM=Car Dealer Monitor <no-reply@yourdomain.com>

# SMTP server used to actually send email (e.g. Gmail, SES, Postmark, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Daily email schedule.
MAIL_HOUR=7
MAIL_TZ=America/New_York
# Set to true to email even when there are no new matches.
MAIL_SEND_EMPTY=false

# How often to scan dealers, in milliseconds (default 30 min).
SCAN_INTERVAL_MS=1800000

# Where the JSON databases live (a mounted disk in production).
DATA_DIR=/data
